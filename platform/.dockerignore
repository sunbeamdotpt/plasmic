# Dependencies and stores
**/node_modules
.pnpm-store
.yarn-cache

# Build outputs
**/build
**/dist
**/*.tsbuildinfo

# Generated files
wab/src/wab/gen
# NOTE: wab/src/wab/client is *not* excluded; server code imports from it at
# runtime (e.g. @/wab/client/components/canvas/slate).
wab/src/wab/shared/model/classes.ts
wab/src/wab/shared/model/classes-metas.ts
wab/src/wab/styles/_tokens.sass
wab/src/wab/styles/_tokens.ts
wab/src/wab/styles/css-variables.scss
wab/src/wab/styles/css-variables.ts
wab/public/static/js

# Git
.git

# Local env/secrets
.env
.env.*
*.local

# Docker
Dockerfile*
.dockerignore

# Packages not copied into the WAB production image runner, but whose source
# is needed in the builder stage to build the frontend static assets.
host-test
integration-tests
loader-tests
react-renderer
